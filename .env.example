# Copie este arquivo para .env (local) e configure as mesmas chaves
# no painel de variáveis de ambiente da Render (nunca commite o .env real).

# --- Obrigatórias para o servidor subir e conectar ao banco ---

# String de conexão do TiDB Cloud (compatível com MySQL). No TiDB Cloud
# Serverless, normalmente exige SSL: mysql://usuario:senha@host:4000/database?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório forte,
# por exemplo: openssl rand -base64 32
JWT_SECRET=

# Porta em que o servidor Express deve escutar. Na Render, isso normalmente
# já vem preenchido automaticamente pela plataforma — não é preciso definir manualmente.
PORT=3000

# --- Login simples (fallback) usado por server/_core/auth.ts ---
APP_USERNAME=
APP_PASSWORD=

# --- Integração com a plataforma Manus (opcional) ---
# Só são necessárias se você quiser manter o proxy de imagens hospedadas em
# /manus-storage/... (textura de fundo e logo do Painel) funcionando fora do
# ambiente Manus. Sem elas, essas duas imagens decorativas ficam quebradas,
# mas o restante do sistema funciona normalmente.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# OAuth institucional (se/quando for implementado; não é usado no modo demonstração)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- Variáveis do cliente (Vite) ---
# Precisam do prefixo VITE_ para serem expostas ao frontend em tempo de build.

# "true" ativa o modo demonstração (dados fictícios) quando não há dados reais no banco.
VITE_DEMO_MODE=false

VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
